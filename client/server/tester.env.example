# Copy to `tester.env` (gitignored by the root `*.env` rule). Sourced by the
# game server's unit (deploy/algomancy-game.service) — and by run-server.sh
# inside its loop, if that is still how you start it. Every value is optional;
# unset means the feature is off, never an error.

# Which port to listen on. The unit sets 5000; the default in main.ts is 8080.
PORT=5000

# R216: the scenario tester. Without it every /api/scenario/* and /api/verdict
# route 404s and the tester is simply absent — the right state for a public
# box that has not opted in (BL-28).
ALGO_TESTER_TOKEN=

# ⚠ MUST MATCH ALGO_BOT_TOKEN IN THE REPO-ROOT .env. Same secret, both ends:
# the bot presents it to /api/bot/*, the server presents it when pushing queue
# events. A mismatch is not an error — every /api/bot/* route just answers
# 404, which looks exactly like the feature not existing.
ALGO_BOT_TOKEN=

# Where to push queue events (the bot's pushserver.py, loopback). Unset = the
# push half is off — silently, so set it or expect no Discord announcements.
ALGO_BOT_PUSH_URL=http://127.0.0.1:8765/push/queue

# Where the rules bot's web app is, for the /api/judge and /api/cardinfo
# proxies. Loopback on the deploy box.
ALGO_BOT_URL=http://127.0.0.1:8000

# What the bot's Join buttons and the profile page's links point at — the
# origin people actually type. Also the only Origin (besides the request's own
# Host) allowed to open a WebSocket here.
ALGO_PUBLIC_URL=

# Where mutable state lives, if not var/ under the repo. The test suite sets
# these per script; a deploy normally leaves them alone.
#ALGO_GAMES_DIR=
#ALGO_ACCOUNTS_FILE=
#ALGO_ISSUES_FILE=
#ALGO_VERDICTS_FILE=

# Override the engine version stamp (normally derived from git + the card pool).
#ALGO_ENGINE_VERSION=
