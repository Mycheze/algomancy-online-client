# --- Secrets / credentials (NEVER commit) ---
# start_commands.txt contains the live DeepSeek API key + Discord bot token
start_commands.txt
# .env holds real secrets; use .env.example as the template
.env
*.env
!.env.example

# --- Runtime logs (contain Discord user IDs + question history) ---
logs/*.jsonl

# --- Discord extraction (tooling + raw dumps + intermediate batches) ---
#     Only the CURATED rulings are committed:
#       data/rulings/seed_rulings.jsonl       (hand-transcribed)
#       data/rulings/generated_rulings.jsonl  (Sonnet-curated designer Q&A)
#     Everything used to PRODUCE them is reproducible and stays out of git:
#     the vendored DiscordChatExporter binary (29 MB, fetch from its GitHub
#     releases), the raw channel dumps + their media, the per-batch work files,
#     and the image-only messages we chose not to OCR.
#     The one hand-written thing that used to be swallowed by the blanket rule
#     below — the export recipe — now lives at bot/pipeline/export_rulings.sh
#     and IS committed.
discord_extractor/
data/rulings/exports/
data/rulings/work/
data/rulings/needs_ocr.jsonl

# --- Local tooling / editor ---
.claude/settings.local.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Stray process output (the server box runs bot/uvicorn/web detached) ---
#     `git status` on the server was showing ten untracked files, which is how
#     a dirty tree stops being information. None of it is worth committing.
*.out
logs/*.log

# --- Ad-hoc backups made by hand before a deploy ---
#     e.g. digital-client.rsync-bak-20260818/, data/corpus/*.jsonl.bak-<stamp>
*.rsync-bak-*/
*.bak-*

# --- OS junk ---
.DS_Store
Thumbs.db
