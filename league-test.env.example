# The league test rig (client/docs/20-league.md §10b). Copy to league-test.env
# (gitignored by the *.env rule) and fill the three blanks.
#
# Read by BOTH halves of the local test:
#   npm --prefix client run dev:league   → the game server on :5177
#   bot/run-test-bot.sh                  → the TEST Discord bot
#
# ⚠ EVERY variable the bot reads is set here ON PURPOSE, even the empty ones.
# bot.py's load_dotenv() walks up from bot/ and finds the main tree's .env —
# the PRODUCTION token — and it only fills variables that are NOT already set.
# Anything missing here would be filled from production.

# ── fill these three ──────────────────────────────────────────────────
# The TEST application's bot token (developer portal → "Algomancy Test" → Bot).
# Never the production one — run-test-bot.sh refuses if it matches .env's.
DISCORD_TOKEN=
# Your own Discord user id (Settings → Advanced → Developer Mode, then
# right-click yourself → Copy User ID). Every league DM comes to you.
ALGO_LEAGUE_DM_REDIRECT=
# Any long random string; the game server and the bot must share it.
ALGO_BOT_TOKEN=

# ── already right for a laptop ────────────────────────────────────────
ALGO_DEV_GUILD=778331995297808438
ALGO_GAME_SERVER=http://127.0.0.1:5177
ALGO_PUBLIC_URL=http://127.0.0.1:5177
ALGO_BOT_LISTEN=127.0.0.1:8766
ALGO_BOT_PUSH_URL=http://127.0.0.1:8766/push/queue
ALGO_BOT_URL=http://127.0.0.1:8000
ALGO_TESTER_TOKEN=league-test-tester-token
ALGO_VAR_DIR=var/dev/bot
ALGO_LEAGUE_POLL=10
ALGO_QUEUE_COOLDOWN=5
ALGO_QUEUE_CHANNEL_COOLDOWN=5
ALGO_CARDWATCH_CHANNEL=
