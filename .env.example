# Copy to `.env` and fill in. The bot loads this automatically (python-dotenv).

# Discord bot token — https://discord.com/developers/applications
# Enable the "Message Content Intent" under Bot settings.
DISCORD_TOKEN=

# DeepSeek API key — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional overrides:
# deepseek-v4-flash = cheap/fast (default). deepseek-v4-pro = stronger reasoning.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Reasoning router (core.py). "auto" sends only the questions that look like
# they need it; "always"/"never" force the decision.
DEEPSEEK_REASONING=auto
DEEPSEEK_REASONING_EFFORT=high


# ── talking to the digital client's game server ───────────────────────
#
# The bot reads the card query language, the queue and the ladder off the game
# server, and the game server pushes queue events back. Both are loopback on
# the deploy box.

# Where the game server is. Empty/unset is the same as the default.
ALGO_GAME_SERVER=http://127.0.0.1:5000
ALGO_GAME_SERVER_TIMEOUT=5

# ⚠ THIS VALUE LIVES IN TWO FILES AND THEY MUST MATCH. Here, and in
# client/server/tester.env which run-server.sh sources inside its respawn loop.
# A mismatch is not an error: the server's gate answers 404 to everything,
# which looks exactly like the feature not existing.
#
# Unset = the whole integration is off. The bot does not start its listener,
# the server does not serve /api/bot/*, and the profile page shows no
# Connections block. That is the intended state for a deploy that has not
# opted in.
ALGO_BOT_TOKEN=

# Where the bot listens for pushed queue events. Loopback only: the deploy box
# opens 22/80/443/5000/8000, so this is unreachable from outside by
# construction. The game server needs ALGO_BOT_PUSH_URL pointing here.
ALGO_BOT_LISTEN=127.0.0.1:8765

# What the "Join the queue" button links to. No button at all if unset —
# better none than one pointing at 127.0.0.1.
ALGO_PUBLIC_URL=

# Anti-spam for queue announcements: seconds before the same person can
# trigger another, and the floor under any one channel.
ALGO_QUEUE_COOLDOWN=600
ALGO_QUEUE_CHANNEL_COOLDOWN=60

# ⚠ A DEV LAPTOP ONLY — NEVER SET THIS ON THE DEPLOY BOX. Guild-scoped slash
# syncs land instantly, which is the only way to iterate; but copy_global_to
# makes guild COPIES of every command, so once a global sync has propagated a
# guild holding copies as well shows everything TWICE. Ben's Personal Server
# is 778331995297808438.
ALGO_DEV_GUILD=
