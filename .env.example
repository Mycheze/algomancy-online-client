# Copy to `.env` and fill in. The bot loads this automatically (python-dotenv).

# Discord bot token — https://discord.com/developers/applications
# Enable the "Message Content Intent" under Bot settings.
DISCORD_TOKEN=

# ── the rules bot's model (bot/core.py) ───────────────────────────────
#
# Any OpenAI-compatible chat-completions API. Every LLM_* name below falls back
# to the DEEPSEEK_* name it replaced (DEEPSEEK_API_KEY, DEEPSEEK_MODEL,
# DEEPSEEK_BASE_URL, DEEPSEEK_REASONING, DEEPSEEK_REASONING_EFFORT,
# DEEPSEEK_TIMEOUT), so a .env written before 2026-10-11 keeps working as is.
# ⚠ Keys come from here (or the environment) only, never the command line.

# DeepSeek: https://platform.deepseek.com · OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# deepseek-flash = V4.1 Flash, cheap/fast (default; `deepseek-v4-flash` is its
# retired alias). deepseek-v4-pro = stronger. On OpenRouter use its ids
# (e.g. deepseek/…) with LLM_BASE_URL=https://openrouter.ai/api/v1.
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# How to switch thinking on/off is chosen from the base URL's host (deepseek,
# openrouter, else generic). Force one for a proxy: deepseek|openrouter|generic
#LLM_PROVIDER=

# Reasoning router. "auto" sends only the questions that look like they need
# it; "always"/"never" force the decision.
LLM_REASONING=auto
LLM_REASONING_EFFORT=high

# Seconds per model attempt, wall clock. At most two attempts (a retry, or the
# fallback below) run inside LLM_DEADLINE, which must stay under the game
# server's 60 s /api/judge proxy. ⚠ A leftover DEEPSEEK_TIMEOUT=60 still counts
# as LLM_TIMEOUT: then the first attempt takes the whole deadline and nothing
# is retried. Delete it, or set 25.
LLM_TIMEOUT=25
LLM_DEADLINE=55

# Optional: a second model tried once, instead of the retry, when the primary
# times out, errors 5xx/429 or answers empty. Base URL and key default to the
# primary's. Logged as `fallback` on the answer's row.
#LLM_FALLBACK_MODEL=
#LLM_FALLBACK_BASE_URL=
#LLM_FALLBACK_API_KEY=


# ── talking to the digital client's game server ───────────────────────
#
# The bot reads the card query language, the queue and the ladder off the game
# server, and the game server pushes queue events back. Both are loopback on
# the deploy box.

# Where the game server is. Empty/unset is the same as the default.
ALGO_GAME_SERVER=http://127.0.0.1:5000
ALGO_GAME_SERVER_TIMEOUT=5

# ⚠ THIS VALUE LIVES IN TWO FILES AND THEY MUST MATCH. Here, and in
# client/server/tester.env (see tester.env.example there), which the game
# server's unit reads. A mismatch is not an error: the server's gate answers
# 404 to everything, which looks exactly like the feature not existing.
#
# Unset = the whole integration is off. The bot does not start its listener,
# the server does not serve /api/bot/*, and the profile page shows no
# Connections block. That is the intended state for a deploy that has not
# opted in.
ALGO_BOT_TOKEN=

# Where the bot listens for pushed queue events. Loopback only, and
# pushserver.py refuses to start on anything else. The game server needs
# ALGO_BOT_PUSH_URL (below, or in tester.env) pointing at this address.
ALGO_BOT_LISTEN=127.0.0.1:8765

# ── read by the GAME SERVER (client/server), which loads this file too ──
# Where the server pushes queue events: the listener above, plus its path.
# ⚠ Unset = the push half is silently off. No error, no announcements.
ALGO_BOT_PUSH_URL=http://127.0.0.1:8765/push/queue
# Where the rules bot's web app is, for the /api/judge and /api/cardinfo
# proxies. Loopback on the deploy box (app.py binds 127.0.0.1 by default).
ALGO_BOT_URL=http://127.0.0.1:8000

# What the "Join the queue" button links to. No button at all if unset —
# better none than one pointing at 127.0.0.1.
ALGO_PUBLIC_URL=

# Anti-spam for queue announcements: seconds before the same person can
# trigger another, and the floor under any one channel.
ALGO_QUEUE_COOLDOWN=600
ALGO_QUEUE_CHANNEL_COOLDOWN=60

# ⚠ A DEV LAPTOP ONLY — NEVER SET THIS ON THE DEPLOY BOX. Guild-scoped slash
# syncs land instantly, which is the only way to iterate; but copy_global_to
# makes guild COPIES of every command, so once a global sync has propagated a
# guild holding copies as well shows everything TWICE. Ben's Personal Server
# is 778331995297808438.
ALGO_DEV_GUILD=

# ── watching for card errata (cogs/cardwatch.py) ──────────────────────
#
# Caleb errataes cards and announces it in #card-changes in HIS Discord, which
# this bot cannot read (it is in one guild and gets 403 there). The owner's
# server FOLLOWS that channel, so his posts arrive somewhere the bot can see.
# Point this at that mirrored channel: it is both what is watched and where the
# reports go.
#
# Unset = the whole feature is off, listener and daily poll alike. That is the
# intended state for a deploy that has not opted in.
#
# ⚠ TWO SOURCES ON PURPOSE. A post arriving runs the diff against
# algomancer.cc; the diff ALSO runs daily whether or not anything was posted,
# because a channel follow only forwards posts the author publishes and the
# mirror sat silent through nine card changes on 2026-09-21. Neither half is
# allowed to be the only one.
ALGO_CARDWATCH_CHANNEL=
# How often to poll the feed when nothing has been posted. Daily; Caleb
# errataes in batches and a tighter loop finds the same nothing more often.
ALGO_CARDWATCH_HOURS=24

# ── the league (cogs/league.py, client/docs/20-league.md) ─────────────
# Nothing to switch on: the league is live whenever ALGO_BOT_TOKEN is. The bot
# pulls the server's outbox of league messages (pairings, results, reminders)
# every ALGO_LEAGUE_POLL seconds and acks what it sent; `/league channel` in a
# channel picks where the public posts go.
ALGO_LEAGUE_POLL=30
# ⚠ TESTING ONLY — NEVER ON THE DEPLOY BOX. A Discord user id: every league DM,
# to anybody, linked or not, goes to that user instead, headed with who it was
# for. It is how one person sees every message ten simulated players would get.
#ALGO_LEAGUE_DM_REDIRECT=

# ── where mutable state lives ──────────────────────────────────────────
# Everything the Python side writes — answer/feedback/game logs, the queue
# watch list, the slash-tree stamp — goes under var/ in the repo unless this
# points somewhere else. The test scripts set it to a scratch directory
# (bot/test/_scratch_var.py) so a test run can never touch the deployment's.
#ALGO_VAR_DIR=
